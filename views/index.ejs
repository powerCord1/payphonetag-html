<%- include('partials/header') %>

  <header class="app-header">
    <div class="brand-section">
      <div class="brand-logo">☎</div>
      <div>
        <h1 class="brand-title">Payphone Tag</h1>
        <div class="brand-subtitle">Claim your turf</div>
      </div>
    </div>

    <div class="user-banner">
      <div class="player-avatar" style="background-color: <%= identity.color || '#3b82f6' %>;">
        <%= identity.emoji %>
      </div>
      <div class="player-details">
        <span class="player-name">
          <%= identity.name %>
        </span>
        <span class="player-meta">
          Rank #<%= snapshot.rank || 'N/A' %> &bull; <%= identity.shape || 'Player' %>
        </span>
      </div>

      <form action="/logout" method="POST" class="logout-form" style="margin-left: 0.5rem;">
        <button type="submit" title="Disconnect PIN">Logout</button>
      </form>
    </div>
  </header>

  <nav class="tabs-nav">
    <a href="/?tab=alerts" class="tab-link <%= activeTab === 'alerts' ? 'active' : '' %>">
      <span>Alerts</span>
      <span class="tab-badge">
        <%= events.length %>
      </span>
    </a>
    <a href="/?tab=stats" class="tab-link <%= activeTab === 'stats' ? 'active' : '' %>">
      <span>Stats</span>
    </a>
    <a href="/?tab=notifications" class="tab-link <%= activeTab === 'notifications' ? 'active' : '' %>">
      <span>Notifications</span>
      <% if (snapshot.custom_alerts && snapshot.custom_alerts.length> 0) { %>
        <span class="tab-badge" style="background: #f59e0b;">
          <%= snapshot.custom_alerts.length %>
        </span>
        <% } %>
    </a>
  </nav>

  <main>
    <% if (activeTab==='alerts' ) { %>
      <%- include('partials/alerts') %>
        <% } else if (activeTab==='stats' ) { %>
          <%- include('partials/stats') %>
            <% } else if (activeTab==='notifications' ) { %>
              <%- include('partials/notifications') %>
                <% } %>
  </main>

  <%- include('partials/footer') %>