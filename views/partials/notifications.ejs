<div class="section-card">
  <div class="section-title-bar">
    <h2>
      Notifications
    </h2>
    <span class="badge-count"><%= (snapshot.custom_alerts || []).length %> Messages</span>
  </div>

  <% if (!snapshot.custom_alerts || snapshot.custom_alerts.length === 0) { %>
    <div class="empty-state">
      <p>No notifications at the moment.</p>
    </div>
  <% } else { %>
    <div class="notifications-feed">
      <% snapshot.custom_alerts.forEach(alert => { %>
        <div class="notification-card">
          <div class="notification-icon">
          <div>
            <div class="notification-message"><%= alert.message %></div>
            <div class="alert-time"><%= formatDate(alert.created_at) %></div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
