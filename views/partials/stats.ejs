<div class="section-card">
  <div class="section-title-bar">
    <h2>
      Player Statistics
    </h2>
    <span class="badge-count">Rank #<%= snapshot.rank || 'N/A' %> &bull; <%= snapshot.total_score || 0 %> PTS</span>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Current Rank</span>
      <span class="stat-value" style="color: #38bdf8;">#<%= snapshot.rank || '-' %></span>
      <span class="stat-subtext">National leaderboard</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Total Score</span>
      <span class="stat-value" style="color: #ec4899;"><%= snapshot.total_score || 0 %></span>
      <span class="stat-subtext">Points accumulated</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Current Streak</span>
      <span class="stat-value" style="color: #f59e0b;"><%= snapshot.current_streak || 0 %></span>
      <span class="stat-subtext">Best Streak: <%= snapshot.best_streak || 0 %> days</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Total Captures</span>
      <span class="stat-value" style="color: #10b981;"><%= snapshot.captures || 0 %></span>
      <span class="stat-subtext">Payphones captured</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Days Played</span>
      <span class="stat-value"><%= snapshot.days_played || 0 %></span>
      <span class="stat-subtext">Active gameplay days</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Status</span>
      <span class="stat-value" style="font-size: 1.3rem; text-transform: capitalize; color: #a7f3d0;">
        <%= snapshot.moderation_state || 'Active' %>
      </span>
      <span class="stat-subtext">Account standing</span>
    </div>

    <% if (snapshot.nemesis) { %>
      <div class="nemesis-card">
        <div class="nemesis-info">
          <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #f472b6; font-weight: 700; letter-spacing: 0.05em;">Current Nemesis</div>
            <div style="font-size: 1.2rem; font-weight: 800; color: #ffffff;"><%= snapshot.nemesis %></div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <% if (snapshot.badges && snapshot.badges.length > 0) { %>
    <h3 class="badges-header">Badges Earned (<%= snapshot.badges.length %>)</h3>
    <div class="badges-grid">
      <% snapshot.badges.forEach(badge => { %>
        <div class="badge-item unlocked">
          <%= formatBadgeName(badge) %>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
